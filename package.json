{
  "name": "download-cleaner-lite",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc",
    "pack": "rm -f download-cleaner-lite.zip && cat files_to_zip.txt | zip -@ download-cleaner-lite.zip",
    "lint": "eslint lib/*.ts *.ts",
    "lint:format": "prettier --check *.ts lib/*.ts *.html *.json",
    "format": "prettier --write *.ts lib/*.ts *.html *.json"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "eslint": "~10.8.1",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.67.0",
    "web-ext-types": "~3.2.1"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": false
  }
}
